# Runtime
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTO_CREATE_TABLES=true

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=ppe_detection
DATABASE_URL=postgresql://postgres:change-this-database-password@db:5432/ppe_detection

# One-time administrator bootstrap. Remove the password after the first successful startup.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
ALLOW_PUBLIC_REGISTRATION=false

# AI model and camera runtime
MODEL_PATH=./yolo8s.pt
MODEL_VERSION=sh17-yolov8s-baseline
# Leave false for the bundled SH17 research baseline. Set true only after legal review.
MODEL_LICENSE_APPROVED=false
CONFIDENCE_THRESHOLD=0.25
PERSON_CONFIDENCE_THRESHOLD=0.40
CAMERA_ANALYSIS_FPS=5
TEMPORAL_WINDOW_SIZE=5
TEMPORAL_CONFIRM_COUNT=4
TEMPORAL_CLEAR_COUNT=3
EVENT_COOLDOWN_SECONDS=60
VIDEO_FRAME_STRIDE=5
VIDEO_MAX_ANALYZED_FRAMES=600

# Evidence and retention
UPLOAD_DIR=./uploads
EVIDENCE_DIR=./uploads/evidence
MAX_FILE_SIZE=104857600
MAX_FRAME_SIZE=10485760
EVIDENCE_RETENTION_DAYS=30
METADATA_RETENTION_DAYS=365

# Email alerts (leave SMTP_HOST empty to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ALERT_RECIPIENTS=
